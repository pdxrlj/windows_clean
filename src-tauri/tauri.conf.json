{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanSweep",
  "version": "0.1.0",
  "identifier": "com.cleansweep.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CleanSweep — AI 卸载助手",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "AI-assisted Windows uninstaller",
    "longDescription": "Enumerate installed software, uninstall cleanly, scan for residuals, and use AI to analyze purpose, risk and leftover safety."
  }
}
